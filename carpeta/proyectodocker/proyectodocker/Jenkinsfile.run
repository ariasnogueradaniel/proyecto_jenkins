\pipeline {
    agent any
    
    parameters {
        choice(
            name: 'IMAGE_TAG',
            choices: ['Daniel_Arias', 'latest', 'build-17', '20251213-111331'],
            description: 'Tag de la imagen desde el registry local'
        )
        
        choice(
            name: 'ACCION',
            choices: [
                'verificar_registry',
                'probar_imagen',
                'ejecutar_app',
                'comandos_personales'
            ],
            description: 'Accion a realizar'
        )
        
        string(
            name: 'COMANDO_PERSONAL',
            defaultValue: 'java -version && echo "Hola desde mi proyecto"',
            description: 'Comando personalizado'
        )
    }
    
    environment {
        REGISTRY_URL = 'localhost:5000'
        IMAGE_FULL = 'localhost:5000/proyecto-docker'
    }
    
    stages {
        stage('Verificar Registry Local') {
            steps {
                bat """
                    echo "Comprobando registry local..."
                    docker ps | findstr "registry"
                    
                    echo "Catalogo disponible:"
                    curl -X GET http://localhost:5000/v2/_catalog
                    
                    echo "Tags de 'proyecto-docker':"
                    curl -X GET http://localhost:5000/v2/proyecto-docker/tags/list
                """
            }
        }
        
        stage('Pull desde Registry Local') {
            steps {
                bat """
                    echo "Descargando imagen desde registry local..."
                    echo "Imagen: ${IMAGE_FULL}:${params.IMAGE_TAG}"
                    
                    docker pull ${IMAGE_FULL}:${params.IMAGE_TAG}
                    
                    echo "Descarga completada"
                    echo "Imagen descargada:"
                    docker images "${IMAGE_FULL}:${params.IMAGE_TAG}"
                """
            }
        }
        
        stage('Ejecutar Accion Seleccionada') {
            steps {
                script {
                    echo "Accion seleccionada: ${params.ACCION}"
                    
                    def cmd = ""
                    
                    switch(params.ACCION) {
                        case 'verificar_registry':
                            cmd = "echo '=== VERIFICACION COMPLETA ===' && echo 'Estudiante: ${params.IMAGE_TAG}' && echo 'Docker Info:' && docker --version && echo 'Java:' && java -version 2>&1 && echo 'Contenido del contenedor:' && ls -la /app 2>/dev/null || ls -la / && echo 'Verificacion completada'"
                            break
                            
                        case 'probar_imagen':
                            cmd = "echo 'Probando funcionalidades...' && echo '1. Sistema operativo:' && cat /etc/os-release 2>/dev/null || echo 'Sin info de OS' && echo '2. Variables de entorno:' && echo 'PATH: \$PATH' && echo '3. Espacio disponible:' && df -h 2>/dev/null || echo 'Sin info de disco' && echo 'Pruebas completadas'"
                            break
                            
                        case 'ejecutar_app':
                            cmd = "echo 'Iniciando aplicacion...' && echo 'Puerto: 8080' && echo 'Directorio: /app' && echo 'Simulacion de aplicacion corriendo...' && sleep 2 && echo 'Aplicacion lista'"
                            break
                            
                        case 'comandos_personales':
                            cmd = params.COMANDO_PERSONAL
                            break
                    }
                    
                    bat """
                        echo "EJECUTANDO EN CONTENEDOR:"
                        echo "=============================="
                        echo "Imagen: ${IMAGE_FULL}:${params.IMAGE_TAG}"
                        echo "Accion: ${params.ACCION}"
                        echo "------------------------------"
                        
                        docker run --rm ${IMAGE_FULL}:${params.IMAGE_TAG} /bin/sh -c '${cmd}'
                        
                        echo "------------------------------"
                        echo "Ejecucion completada"
                    """
                }
            }
        }
        
        stage('Demostracion para Revision') {
            steps {
                bat """
                    echo "DEMOSTRACION PARA LA REVISION"
                    echo "================================"
                    
                    echo "Mostrando que la imagen esta en el registry:"
                    curl -s http://localhost:5000/v2/proyecto-docker/tags/list
                    
                    echo.
                    echo "Mostrando que podemos hacer pull:"
                    docker images | findstr "localhost:5000/proyecto-docker"
                    
                    echo.
                    echo "Ejecutando comando de verificacion rapido:"
                    docker run --rm ${IMAGE_FULL}:${params.IMAGE_TAG} echo "Contenedor funcionando - Estudiante: ${params.IMAGE_TAG}"
                """
            }
        }
    }
    
    post {
        always {
            bat """
                echo "Limpieza post-ejecucion..."
                docker container prune -f
                echo "Listo para siguiente ejecucion"
            """
        }
        success {
            echo "PIPELINE2 COMPLETADO"
            echo "Imagen usada: ${IMAGE_FULL}:${params.IMAGE_TAG}"
            echo "Registry local activo: ${REGISTRY_URL}"
            echo "Para la defensa, muestra los comandos curl y docker pull"
        }
    }
}